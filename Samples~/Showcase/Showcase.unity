  _zones:
  - label: Z1_Bowling
    root: {fileID: 1167941406}
    playerSpawn: {fileID: 1191011426}
    commands: 'LMB | launch ball

      Space | reset pins'
    unlockCursorOnEnter: 0
  - label: Z2_Door
    root: {fileID: 679940419}
    playerSpawn: {fileID: 492910101}
    commands: "F | open / close door\nG | slam \nL | lock / unlock "
    unlockCursorOnEnter: 0
  - label: Z3_Fishing
    root: {fileID: 1015836569}
    playerSpawn: {fileID: 1271875604}
    commands: 'LMB hold | Attach object (suspend)

      LMB release | Drop object

      Mouse
      move | Transfer rod tip speed (inertia)'
    unlockCursorOnEnter: 0
  - label: Z4_Stream
    root: {fileID: 1886265420}
    playerSpawn: {fileID: 703210528}
    commands: 'Space | start/stop stream

      Tab | lock/unlock cursor (before
      slider use)

      Slider | realtime gain/pan modulation'
    unlockCursorOnEnter: 1
  - label: Z5_ChargeShot
    root: {fileID: 296434734}
    playerSpawn: {fileID: 1742288848}
    commands: 'LMB hold | charge

      release | shoot'
    unlockCursorOnEnter: 0
  _player: {fileID: 2113912042}
  _initialZone: 1
  _centerActiveZoneOnEnter: 1
  _activeZonePosition: {x: 0, y: 0, z: 0}
  _verboseLog: 0
