  m_Script: {fileID: 11500000, guid: 79ced69ebcbb9fc47a5eb7cf41b3d1c3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hapbeat.Samples.Showcase.HudGuide
  _keysText: {fileID: 1342404225}
  _descText: {fileID: 376879015}
  _guideText: {fileID: 0}
  _connectionStatusText: {fileID: 513074510}
  _zoneSwitcher: {fileID: 848201979}
  _globalHeader: 'WASD | move

    Mouse | look

    1-5 | zone switch

    Q | manual
    fire

    P | ping '
  _guideContent: 'WASD: move    Mouse: look    Esc: quit

    [Z1] LMB: launch ball  
    Space: reset pins

    [Z2] F: open/close door

    [Z3] LMB: pickup / drop box

    [Z4]
    Space: stream toggle, sliders modulate gain/pan

    [Z5] LMB hold: charge, release:
    shoot target


    Q: manual fire   1-5: PlayScaled (gain step)   P: Ping'
